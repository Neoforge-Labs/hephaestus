{
  "suite": "money.allocate",
  "spec": "0.1.0",
  "description": "Split an amount so parts sum exactly to the input. Remainder minor units go one each to the earliest parts with non-zero ratio (a negative amount allocates its magnitude and negates). Allocation semantics are not in spec section 3 yet: the cases here use only inputs on which sequential and largest-remainder methods agree. An empty ratio list and an all-zero ratio list are rejected with HEPH-MONEY-422; negative ratios are unspecified and deliberately not pinned.",
  "source": "Hand-derived arithmetic; exact large values checked by integer division only.",
  "cases": [
    {
      "name": "kes-100-by-1-1-1",
      "input": {
        "money": {
          "amount": "100",
          "currency": "KES"
        },
        "ratios": [
          1,
          1,
          1
        ]
      },
      "expect": {
        "parts": [
          {
            "amount": "34",
            "currency": "KES"
          },
          {
            "amount": "33",
            "currency": "KES"
          },
          {
            "amount": "33",
            "currency": "KES"
          }
        ]
      }
    },
    {
      "name": "kes-5-by-1-1",
      "input": {
        "money": {
          "amount": "5",
          "currency": "KES"
        },
        "ratios": [
          1,
          1
        ]
      },
      "expect": {
        "parts": [
          {
            "amount": "3",
            "currency": "KES"
          },
          {
            "amount": "2",
            "currency": "KES"
          }
        ]
      }
    },
    {
      "name": "kes-neg-100-by-1-1-1",
      "input": {
        "money": {
          "amount": "-100",
          "currency": "KES"
        },
        "ratios": [
          1,
          1,
          1
        ]
      },
      "expect": {
        "parts": [
          {
            "amount": "-34",
            "currency": "KES"
          },
          {
            "amount": "-33",
            "currency": "KES"
          },
          {
            "amount": "-33",
            "currency": "KES"
          }
        ]
      }
    },
    {
      "name": "kes-100-by-0-1",
      "input": {
        "money": {
          "amount": "100",
          "currency": "KES"
        },
        "ratios": [
          0,
          1
        ]
      },
      "expect": {
        "parts": [
          {
            "amount": "0",
            "currency": "KES"
          },
          {
            "amount": "100",
            "currency": "KES"
          }
        ]
      }
    },
    {
      "name": "kes-100-zero-ratios",
      "input": {
        "money": {
          "amount": "100",
          "currency": "KES"
        },
        "ratios": [
          0,
          0
        ]
      },
      "expect": {
        "error": "HEPH-MONEY-422"
      }
    },
    {
      "name": "kes-100-no-ratios",
      "input": {
        "money": {
          "amount": "100",
          "currency": "KES"
        },
        "ratios": []
      },
      "expect": {
        "error": "HEPH-MONEY-422"
      }
    },
    {
      "name": "kes-1-by-1-1-1",
      "input": {
        "money": {
          "amount": "1",
          "currency": "KES"
        },
        "ratios": [
          1,
          1,
          1
        ]
      },
      "expect": {
        "parts": [
          {
            "amount": "1",
            "currency": "KES"
          },
          {
            "amount": "0",
            "currency": "KES"
          },
          {
            "amount": "0",
            "currency": "KES"
          }
        ]
      }
    },
    {
      "name": "kes-100-by-1-2-3",
      "input": {

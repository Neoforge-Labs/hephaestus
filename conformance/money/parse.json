    {
      "name": "kes-reject-10",
      "input": {
        "amount": "10",
        "currency": "KES",
        "rounding": "reject"
      },
      "expect": {
        "minor": "1000"
      }
    },
    {
      "name": "kes-reject-0p01",
      "input": {
        "amount": "0.01",
        "currency": "KES",
        "rounding": "reject"
      },
      "expect": {
        "minor": "1"
      }
    },

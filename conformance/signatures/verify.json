{
  "suite": "signatures.verify",
  "spec": "0.3.0",
  "description": "Verification (spec 5). `now` is the verifier clock in integer seconds. All three header keys are always present; an absent header is the empty string. Tolerance 300 s, inclusive.",
  "source": "standardwebhooks.Webhook.verify with its clock pinned to `now` (rfc8785 0.1.4, standardwebhooks 1.1.0); any exception counts as rejection (spec 5.6); the two non-UTF-8 cases, the leading-zero-timestamp case and the empty-key case are derived with stdlib hmac (the package only takes str and formats integer timestamps). Every case's intended outcome is also stated in this script and the run aborts if the package disagrees.",
  "cases": [
    {
      "name": "valid",
      "input": {
        "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
        },
        "payload_b64": "eyJ0ZXN0IjogMjQzMjIzMjMxNH0=",
        "now": 1614265340
      },
      "expect": {
        "ok": true
      }
    },
    {
      "name": "payload-tampered",
      "input": {
        "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
        },
        "payload_b64": "eyJ0ZXN0IjogMjQzMjIzMjMxNX0=",
        "now": 1614265340
      },
      "expect": {
        "error": "HEPH-WH-401"
      }
    },
    {
      "name": "timestamp-301-seconds-old",
      "input": {
        "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
        },
        "payload_b64": "eyJ0ZXN0IjogMjQzMjIzMjMxNH0=",
        "now": 1614265631
      },
      "expect": {
        "error": "HEPH-WH-401"
      }
    },
    {
      "name": "timestamp-301-seconds-in-the-future",
      "input": {
        "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
        },
        "payload_b64": "eyJ0ZXN0IjogMjQzMjIzMjMxNH0=",
        "now": 1614265029
      },
      "expect": {
        "error": "HEPH-WH-401"
      }
    },
    {
      "name": "timestamp-exactly-300-seconds-old-accepted",
      "input": {
        "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
        },
        "payload_b64": "eyJ0ZXN0IjogMjQzMjIzMjMxNH0=",
        "now": 1614265630
      },
      "expect": {
        "ok": true
      }
    },
    {
      "name": "timestamp-exactly-300-seconds-in-the-future-accepted",
      "input": {
        "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
        "headers": {
          "webhook-id": "msg_p5jXN8AQM9LWM0D4loKWxJek",
          "webhook-timestamp": "1614265330",
          "webhook-signature": "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="

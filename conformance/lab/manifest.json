    {
      "name": "single-file",
      "input": {
        "manifest": {
          "dataset": "demo",
          "source": "https://example.org/demo",
          "release": "2026-01",
          "extractor_version": "0.1.0",
          "captured_at": "2026-02-03",
          "files": [
            {
              "path": "a.csv",
              "sha256": "c15097c46e6dbfe67d8106c18b850ff4312898c146771669ae50324f910ed93c",
              "bytes": 13
            }
          ]
        }
      },
      "expect": {
        "data_hash": "sha256:0053236c261700212396e25811b44581f5c36421001bc8b5dbee449deaa5b302"
      }
    },

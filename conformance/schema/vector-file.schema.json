                          "properties": {
                            "amount": {
                              "type": "string",
                              "pattern": "^(0|-?[1-9][0-9]*)$"
                            },
                            "currency": {
                              "type": "string",
                              "pattern": "^[A-Z]{3}$"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "error": {
                          "type": "string",
                          "pattern": "^HEPH-[A-Z]{2,6}-[0-9]{3}$"
                        }
                      }
                    }
                  ]

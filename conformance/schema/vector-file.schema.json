                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "error": {
                          "type": "string",
                          "pattern": "^HEPH-[A-Z]{2,6}-[0-9]{3}$"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephkit.dev/conformance/vector-file.schema.json",
  "title": "Hephaestus conformance vector file",
  "description": "Contract for every conformance/<area>/<suite>.json. An error expectation is {\"error\": \"<HEPH code>\"}; the checker also confirms the code is in spec/errors.yaml.",
  "type": "object",
  "required": [
    "suite",
    "spec",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "suite": {
      "enum": [
        "money.currency",
        "money.parse",
        "money.format",
        "money.arith",
        "money.compare",
        "money.allocate",
        "hashing.jcs",
        "hashing.content",
        "signatures.sign",
        "signatures.verify",
        "idempotency.key",
        "idempotency.fingerprint",
        "lab.config",
        "lab.provenance",
        "lab.diff"
      ]
    },
    "spec": {
      "const": "0.5.0"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "input",
          "expect"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "input": {
            "type": "object"
          },
          "expect": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "suite": {
            "const": "money.currency"
          }
        },
        "required": [
          "suite"
        ]
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "input": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                },
                "expect": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "exponent"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "exponent": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "error": {
                          "type": "string",
                          "pattern": "^HEPH-[A-Z]{2,6}-[0-9]{3}$"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "suite": {
            "const": "money.parse"
          }
        },
        "required": [
          "suite"
        ]
      },
      "then": {

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "packages": {
    "core/hephkit-core": {
      "release-type": "rust",
      "component": "hephkit-core"
    },
    "core/hephkit-py": {
      "release-type": "rust",
      "component": "hephkit-py"
    },
    "python/hephkit": {
      "release-type": "python",
      "component": "hephkit"
    },
    "go": {
      "release-type": "simple",
      "component": "heph",
      "extra-files": ["internal/cli/version.go"]
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "hephaestus",
      "components": ["hephkit-core", "hephkit-py", "hephkit", "heph"]
    }
  ]
}
